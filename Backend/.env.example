PORT=5000

# =========================
# MongoDB
# =========================
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/Nestesy

# =========================
# JWT
# =========================
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# Brevo
# =========================
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=Nestesy

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/tenant/auth/google/callback

# =========================
# Frontend
# =========================
FRONTEND_URL=http://localhost:5173

# =========================
# Admin
# =========================
ADMIN_EMAIL=admin@example.com
ADMIN_SETUP_KEY=nestesy-admin-secret